# Copy to /etc/fips-exit/tunnel.env (root-only) and adjust.

# The exit's connectivity SOCKS endpoint over fips. Prefer the address literal
# here (no name lookup needed before the tunnel is up); the <npub>.fips name
# works too if fips' resolver is reachable at boot.
EXIT_SOCKS=socks5://[fd00:0:0:0:0:0:0:1]:1080
# Your fips TUN interface and the name of the tunnel interface to create.
FIPS_IF=fips0
TUN_IF=fipsexit0

# Keep the fips daemon's own transport OUT of the tunnel, or it loops:
# - best: run fips under its own user and put that uid here;
FIPS_UID=
# - or list the public IPs/CIDRs of your fips peers (UDP/TCP transports), space
#   separated. Not needed for raw Ethernet/WiFi/Bluetooth transports.
UPLINK_EXCLUDE=

# DNS: "resolved" configures systemd-resolved with DNS-over-TLS on the tunnel
# (plain UDP DNS cannot cross the exit's connect-only SOCKS). "skip" leaves DNS
# alone — then make sure your resolver uses DoT/DoH yourself.
DNS_MODE=resolved
DNS_SERVERS=1.1.1.1#cloudflare-dns.com 9.9.9.9#dns.quad9.net
