# Copy to .env and adjust. Consumed by docker-compose and up.sh.

# fips TUN interface on this host (where clients reach the exit).
FIPS_IF=fips0
# This node's own fips address; services listen here.
EXIT_FIPS_ADDR=fd00:0:0:0:0:0:0:1
# Public interface used for internet egress (IPv4 + IPv6).
EXTERNAL_IF=eth0

# Ports.
# Connectivity service (Phase 4c): the client-facing, gated+metered SOCKS port
# on EXIT_FIPS_ADDR. The dispatcher listens here and routes *.onion -> Tor,
# everything else -> Dante. Keep in sync with services.conf (the gated port).
CONNECTIVITY_PORT=1080
# Dante's own SOCKS port. It now listens on LOOPBACK only (CLEARNET_BIND), reached
# only by the dispatcher — not client-facing. Give it a distinct port for clarity.
CLEARNET_BIND=127.0.0.1
CLEARNET_PORT=1090
CAPTIVE_PORT=1088
# Phase 4b: Tor egress SOCKS port (only used with `--profile tor`). Tor binds
# this on EXIT_FIPS_ADDR only; the nft gate meters it at the catalog's rate.
TOR_PORT=1081
# Loopback SocksPort the dispatcher uses for *.onion routing on the connectivity
# port (Phase 4c). Local-only; part of the `tor` profile. Enabling onion on
# :1080 therefore requires `--profile tor` (the same Tor as the :1081 rail).
TOR_DISPATCH_PORT=9052
# HTTP forward proxy service port (only used with `--profile http`). Binds
# EXIT_FIPS_ADDR only; forwards to Dante (CLEARNET_PORT) over loopback, so it
# inherits the full egress policy. Gate + meter it via services.conf; the catalog
# rate governs billing. See docs/http-proxy.md.
HTTPPROXY_PORT=3128

# Captive redirect target (the user portal) and the HMAC secret for the
# short-lived context token embedded in the redirect. Generate a real secret:
#   openssl rand -base64 32
# Prefer the portal's <npub>.fips URL — it resolves mesh-wide by derivation (no
# per-node hosts entry) and survives an address change. Use the EXIT/portal
# host's own npub. Avoid raw IPv6 literals and local hostname aliases.
#   CAPTIVE_PORTAL_URL=http://npub1<exit-host-npub>.fips:8080/captive
CAPTIVE_PORTAL_URL=https://portal.example/captive
CAPTIVE_TOKEN_SECRET=change-me-32-bytes-of-randomness

WORKERS=4

# Per-source concurrent-connection ceiling on service ports (0 = disabled).
# A single npub/device can't exceed this many simultaneous connections. A
# generous value (e.g. 256) stops abuse without breaking normal browsing.
MAX_CONNS_PER_SRC=0

# --- Exit-agent (only used with `--profile agent`) ----------------------------
# The agent owns the nftables authorized set (Phase 2), replacing allowlist.txt.
# Base URL of the backend the agent reconciles the authorized set against and
# reports usage to (reachable from this node). REQUIRED when running the agent.
FIPS_AGENT_BACKEND_URL=
# One-time enrollment token minted by the backend
# (POST /admin/enroll-token). Required until the node is enrolled; after that the
# agent persists its node id/token in the agent-state volume. See docs/troubleshooting.md.
FIPS_AGENT_ENROLL_TOKEN=
# Human-readable node name shown in the backend (default: the host's hostname).
FIPS_AGENT_NODE_NAME=exit-01
# Fail-closed policy: 1 = after the grace window with the backend unreachable,
# drop all grants (deny) rather than keep the last-known set. 0 = fail-open
# (keep serving known grants through an outage). Default 0.
FIPS_AGENT_FAIL_CLOSED_AFTER_GRACE=0

# Metrics (optional). Set an address to expose Prometheus /metrics; bind these to
# a management interface, not the public one. See docs/observability.md.
FIPS_AGENT_METRICS_ADDR=
CAPTIVE_METRICS_ADDR=
