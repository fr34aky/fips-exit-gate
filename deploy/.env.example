# Copy to .env and adjust. Consumed by docker-compose and up.sh.

# fips TUN interface on this host (where clients reach the exit).
FIPS_IF=fips0
# This node's own fips address; services listen here.
EXIT_FIPS_ADDR=fd00:0:0:0:0:0:0:1
# Public interface used for internet egress (IPv4 + IPv6).
EXTERNAL_IF=eth0

# Ports.
CLEARNET_PORT=1080
CAPTIVE_PORT=1088
# Phase 4b: Tor egress SOCKS port (only used with `--profile tor`). Tor binds
# this on EXIT_FIPS_ADDR only; the nft gate meters it at the catalog's rate.
TOR_PORT=1081

# Captive redirect target (the user portal) and the HMAC secret for the
# short-lived context token embedded in the redirect. Generate a real secret:
#   openssl rand -base64 32
# Prefer the portal's <npub>.fips URL — it resolves mesh-wide by derivation (no
# per-node hosts entry) and survives an address change. Use the EXIT/portal
# host's own npub. Avoid raw IPv6 literals and local hostname aliases.
#   CAPTIVE_PORTAL_URL=http://npub1<exit-host-npub>.fips:8080/captive
CAPTIVE_PORTAL_URL=https://portal.example/captive
CAPTIVE_TOKEN_SECRET=change-me-32-bytes-of-randomness

WORKERS=4

# Per-source concurrent-connection ceiling on service ports (0 = disabled).
# A single npub/device can't exceed this many simultaneous connections. A
# generous value (e.g. 256) stops abuse without breaking normal browsing.
MAX_CONNS_PER_SRC=0

# Metrics (optional). Set an address to expose Prometheus /metrics; bind these to
# a management interface, not the public one. See docs/observability.md.
FIPS_AGENT_METRICS_ADDR=
CAPTIVE_METRICS_ADDR=
