# Copy to backend.env (chmod 600) for deploy/backend-compose.yaml.
PGUSER=fips
PGPASSWORD=change-me
PGDATABASE=fips_exit
# Protects the /admin API. Generate: openssl rand -base64 32
ADMIN_TOKEN=change-me-admin-token

# Portal secrets (generate each: openssl rand -base64 32). If unset, ephemeral
# random secrets are used and sessions/challenges won't survive a restart.
SESSION_SECRET=change-me
CHALLENGE_SECRET=change-me
# Must equal the captive daemon's CAPTIVE_TOKEN_SECRET so the captive landing
# page can verify redirect tokens.
CAPTIVE_TOKEN_SECRET=change-me

# Transparent fips-source login: ON by default (the portal is reached natively
# over fips, and it shares the exit gate's source-address trust model). Set to 0
# ONLY when a reverse proxy masks the client source (e.g. a public HTTPS portal).
PORTAL_TRUST_FIPS_SOURCE=1
# Secure cookies: OFF by default so login works over the fips portal (HTTP).
# Set to 1 when the portal is served over HTTPS.
PORTAL_SECURE_COOKIES=0
# Public base URL of this portal; BTCPay redirects the buyer back here after pay.
# Prefer the portal host's <npub>.fips URL over fips (see docs/configuration.md).
PORTAL_PUBLIC_URL=http://npub1<exit-host-npub>.fips:8080
# Exit SOCKS target the portal-served /fips.pac points browsers at
# (<npub>.fips:<connectivity port>). Empty = derive from PORTAL_PUBLIC_URL's
# <npub>.fips host + :1080 (correct when the portal and exit are the same host).
# Set it for a separate exit host or a non-default connectivity port.
PORTAL_PAC_EXIT=

# --- Payments -----------------------------------------------------------------
# Choose ONE rail. Empty = no rail (purchases stay pending; set
# PORTAL_DEV_AUTOSETTLE=1 for dev to grant immediately).
#   btcpay   = BTCPay Server (on-chain BTC + Lightning + Monero; heavier — see docs/phase4-btcpay.md)
#   phoenixd = direct Lightning via an ACINQ phoenixd node (Lightning-only, light — see docs/phoenixd.md)
PAYMENT_RAIL=

# BTCPay (PAYMENT_RAIL=btcpay):
BTCPAY_URL=
BTCPAY_API_KEY=          # store-scoped Greenfield key, btcpay.store.cancreateinvoice
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=   # must match the store webhook secret
BTCPAY_SOCKS5=           # e.g. 127.0.0.1:9050 to reach a BTCPay .onion over Tor

# phoenixd (PAYMENT_RAIL=phoenixd):
PHOENIXD_URL=            # e.g. http://127.0.0.1:9740
PHOENIXD_PASSWORD=       # the node's http-password (from ~/.phoenix/phoenix.conf)
PHOENIXD_WEBHOOK_SECRET= # must match phoenixd's webhook-secret
PHOENIXD_SOCKS5=         # optional Tor SOCKS5 to reach an onion
PHOENIXD_POLL_INTERVAL_S=15   # reconciler poll interval (settle backup + expiry)
PHOENIXD_INVOICE_TTL_S=3600   # unpaid Lightning invoice lifetime before it's voided

# Cashu accept-and-melt (rides the phoenixd rail): buyers can pay by pasting an
# ecash token, melted at its mint to the purchase's Lightning invoice. No custody
# — access is granted only on the resulting phoenixd receipt. Needs
# PAYMENT_RAIL=phoenixd. See docs/design/cashu-accept-and-melt.md.
CASHU_ACCEPT=            # 1 to enable the "pay with Cashu token" option
CASHU_ACCEPTED_MINTS=   # optional comma-separated mint allowlist; empty = accept any
CASHU_SOCKS5=           # optional Tor SOCKS5 to reach an onion mint

# Dev only: grant purchases immediately without any payment rail. Never in prod.
PORTAL_DEV_AUTOSETTLE=0

# --- Metrics ------------------------------------------------------------------
# If set, GET /metrics requires this bearer token (Prometheus scrapes with it);
# leave empty to serve /metrics openly and restrict it by network. See
# docs/observability.md.
METRICS_TOKEN=
