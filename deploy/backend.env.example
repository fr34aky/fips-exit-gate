# Copy to backend.env (chmod 600) for deploy/backend-compose.yaml.
PGUSER=fips
PGPASSWORD=change-me
PGDATABASE=fips_exit
# Protects the /admin API. Generate: openssl rand -base64 32
ADMIN_TOKEN=change-me-admin-token

# Portal secrets (generate each: openssl rand -base64 32). If unset, ephemeral
# random secrets are used and sessions/challenges won't survive a restart.
SESSION_SECRET=change-me
CHALLENGE_SECRET=change-me
# Must equal the captive daemon's CAPTIVE_TOKEN_SECRET so the captive landing
# page can verify redirect tokens.
CAPTIVE_TOKEN_SECRET=change-me

# Transparent fips-source login: ON by default (the portal is reached natively
# over fips, and it shares the exit gate's source-address trust model). Set to 0
# ONLY when a reverse proxy masks the client source (e.g. a public HTTPS portal).
PORTAL_TRUST_FIPS_SOURCE=1
# Secure cookies: OFF by default so login works over the fips portal (HTTP).
# Set to 1 when the portal is served over HTTPS.
PORTAL_SECURE_COOKIES=0
# Public base URL of this portal; BTCPay redirects the buyer back here after pay.
# Prefer the portal host's <npub>.fips URL over fips (see docs/configuration.md).
PORTAL_PUBLIC_URL=http://npub1<exit-host-npub>.fips:8080

# --- Payments (Phase 4: BTCPay) -----------------------------------------------
# Leave BTCPAY_URL empty to disable payments (purchases stay pending; set
# PORTAL_DEV_AUTOSETTLE=1 instead to grant immediately in dev).
BTCPAY_URL=
# Store-scoped Greenfield API key with the CanCreateInvoice permission.
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# Webhook signing secret configured on the BTCPay store webhook. Must match.
BTCPAY_WEBHOOK_SECRET=
# Set to your Tor SOCKS5 proxy (e.g. 127.0.0.1:9050) to reach a BTCPay .onion.
BTCPAY_SOCKS5=

# Dev only: grant purchases immediately without any payment rail. Never in prod.
PORTAL_DEV_AUTOSETTLE=0

# --- Metrics ------------------------------------------------------------------
# If set, GET /metrics requires this bearer token (Prometheus scrapes with it);
# leave empty to serve /metrics openly and restrict it by network. See
# docs/observability.md.
METRICS_TOKEN=
