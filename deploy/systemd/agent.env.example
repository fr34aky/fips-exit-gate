# Copy to /etc/fips-exit/agent.env (chmod 600) and fill in.
# https://, or plain http:// only to loopback / a fips address / a .fips name
# (the mesh encrypts end to end). FIPS_AGENT_ALLOW_INSECURE=1 overrides.
FIPS_AGENT_BACKEND_URL=https://backend.example
# One-time enrollment token from the backend admin (first run only).
FIPS_AGENT_ENROLL_TOKEN=
# Must match the nftables table from deploy/render-nftables.sh.
FIPS_AGENT_TABLE=inet fips_exit
FIPS_AGENT_NODE_NAME=exit-01
# Optional: flush the authorized set (fail closed) after the grace window when
# the backend stays unreachable. Default is fail-open (keep last-known set).
FIPS_AGENT_FAIL_CLOSED_AFTER_GRACE=0
# Optional pacing / guard knobs (defaults shown); see docs/configuration.md.
#FIPS_AGENT_FULL_SYNC_S=300
#FIPS_AGENT_HEARTBEAT_S=60
#FIPS_AGENT_LONGPOLL_S=50
#FIPS_AGENT_MASS_REVOKE_MIN=50
#FIPS_AGENT_ALLOW_MASS_REVOKE=0
